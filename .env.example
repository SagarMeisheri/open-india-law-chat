# Copy to .env and fill in. Never commit .env.

# --- Required ---------------------------------------------------------------
# Google AI Studio key (https://aistudio.google.com/app/apikey)
GOOGLE_GENAI_USE_ENTERPRISE=FALSE
GOOGLE_API_KEY=

# Voyage AI key (https://dash.voyageai.com). Queries must be embedded with the
# voyage-4 family: the stored vectors live in that space.
VOYAGE_API_KEY=

# --- Models -----------------------------------------------------------------
GEMINI_MODEL=gemini-3.8-flash
# Model for the three small classifier calls. Defaults to GEMINI_MODEL.
# CLASSIFIER_MODEL=
# voyage-4, voyage-4-lite and voyage-4-large are compatible with each other.
VOYAGE_MODEL=voyage-4

# --- Qdrant -----------------------------------------------------------------
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=acts_india
# Seconds. The client default (5) is too short while Qdrant is optimizing.
# QDRANT_TIMEOUT=30

# --- Behaviour --------------------------------------------------------------
# bm25 = hybrid dense+keyword search; off = dense only.
# SPARSE_MODE=bm25
# P(true) the grounding classifier must reach before an answer is shown.
# GROUNDING_THRESHOLD=0.7

# --- Payload field names (verified against acts_india) ----------------------
# FIELD_JURISDICTION=state
# FIELD_ACT_STATUS=act_status
# FIELD_SECTION_STATUS=section_status
# FIELD_YEAR=year
# CENTRAL_VALUE=central
